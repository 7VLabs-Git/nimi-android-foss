<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1C1318"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:paddingStart="6dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_title"
        android:textColor="#FAF7F5"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_btn_fakecall"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:backgroundTint="#FCEEF4"
        android:text="@string/widget_btn_fake_call"
        android:textAllCaps="false"
        android:textColor="#1C1318"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_btn_sos"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:backgroundTint="#D92638"
        android:text="@string/widget_btn_sos_location"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>